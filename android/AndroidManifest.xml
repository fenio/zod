<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine is client/server even in single-player: the client connects
         to an in-process server over a localhost TCP socket. Android denies
         socket() without this, so without it the game can never load a map. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Zod Engine"
        android:hardwareAccelerated="true">

        <!-- RTS: lock to landscape; SDLActivity does the rest -->
        <activity
            android:name="io.github.fenio.zod.ZodActivity"
            android:label="Zod Engine"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"><!-- #85: frameless; restores the fullscreen theme SDL's template manifest had (we overwrite the manifest). A platform theme, so no dependency on the template's styles.xml -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
